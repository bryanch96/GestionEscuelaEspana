<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>
    <!-- Permisos de Profesor en Línea (fotos y videos de evaluación) -->
    <key>NSCameraUsageDescription</key>
    <string>Se usa la cámara para tomar fotografías y videos de evaluación de los estudiantes.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Se usa el micrófono para grabar el audio de los videos de evaluación.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Se accede a la galería para adjuntar fotografías y videos al seguimiento del estudiante.</string>
    <!-- Esquemas que la app puede abrir directamente (WhatsApp y correo) -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>whatsapp</string>
        <string>mailto</string>
    </array>
</dict>
</plist>
