@page "/recuperar"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject IRecuperacionPasswordService Recuperacion
@inject NavigationManager Navigation

<div class="acceso-card">
    <h1>Recuperar contraseña</h1>

    <ol class="pasos">
        <li class="@(paso >= 1 ? "activo" : "")">Correo</li>
        <li class="@(paso >= 2 ? "activo" : "")">Código</li>
        <li class="@(paso >= 3 ? "activo" : "")">Listo</li>
    </ol>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") py-2">@mensaje</div>
    }

    @if (paso == 1)
    {
        <p class="text-muted">Ingrese el correo electrónico registrado en su perfil. Le enviaremos un código de verificación de 6 dígitos.</p>
        <EditForm Model="this" OnSubmit="SolicitarAsync">
            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <div class="input-icono">
                    <span class="ico">mail</span>
                    <input class="form-control" type="email" @bind="correo" autocomplete="email" />
                </div>
            </div>
            <button class="btn btn-primary w-100" type="submit" disabled="@procesando">
                @if (procesando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                Enviar código
            </button>
        </EditForm>
        <button class="btn btn-link w-100 mt-2" @onclick="() => paso = 2">Ya tengo un código</button>
    }
    else if (paso == 2)
    {
        <p class="text-muted">Escriba el código que recibió en <strong>@correo</strong> y su nueva contraseña.</p>
        <EditForm Model="this" OnSubmit="RestablecerAsync">
            @if (string.IsNullOrWhiteSpace(correo))
            {
                <div class="mb-3">
                    <label class="form-label">Correo electrónico</label>
                    <input class="form-control" type="email" @bind="correo" />
                </div>
            }
            <div class="mb-3">
                <label class="form-label">Código de verificación</label>
                <input class="form-control codigo-input" maxlength="6" inputmode="numeric" @bind="codigo" placeholder="000000" />
            </div>
            <div class="mb-3">
                <label class="form-label">Nueva contraseña</label>
                <input class="form-control" type="password" @bind="nueva" @bind:event="oninput" autocomplete="new-password" />
                <IndicadorPassword Password="@nueva" />
            </div>
            <div class="mb-3">
                <label class="form-label">Confirmar contraseña</label>
                <input class="form-control" type="password" @bind="confirmacion" autocomplete="new-password" />
            </div>
            <button class="btn btn-primary w-100" type="submit" disabled="@procesando">
                @if (procesando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                Restablecer contraseña
            </button>
        </EditForm>
        <button class="btn btn-link w-100 mt-2" @onclick="ReenviarAsync" disabled="@procesando">Reenviar código</button>
    }
    else
    {
        <div class="text-center py-3">
            <span class="ico grande text-success">verified_user</span>
            <p class="mt-2">Su contraseña fue actualizada y la cuenta quedó desbloqueada.</p>
        </div>
    }

    <a class="btn btn-outline-secondary w-100 mt-3" href="login"><span class="ico">arrow_back</span> Volver al inicio de sesión</a>
</div>

@code {
    private int paso = 1;
    private string correo = string.Empty;
    private string codigo = string.Empty;
    private string nueva = string.Empty;
    private string confirmacion = string.Empty;
    private string? mensaje;
    private bool exito;
    private bool procesando;

    private async Task SolicitarAsync()
    {
        procesando = true;
        try
        {
            var resultado = await Recuperacion.SolicitarCodigoAsync(correo);
            exito = resultado.Exito;
            mensaje = resultado.Mensaje;
            if (resultado.Exito) paso = 2;
        }
        finally { procesando = false; }
    }

    private async Task ReenviarAsync()
    {
        paso = 1;
        await SolicitarAsync();
    }

    private async Task RestablecerAsync()
    {
        if (nueva != confirmacion)
        {
            exito = false;
            mensaje = "Las contraseñas no coinciden.";
            return;
        }

        procesando = true;
        try
        {
            var resultado = await Recuperacion.RestablecerAsync(correo, codigo, nueva);
            exito = resultado.Exito;
            mensaje = resultado.Mensaje;
            if (resultado.Exito)
            {
                paso = 3;
                nueva = confirmacion = codigo = string.Empty;
            }
        }
        finally { procesando = false; }
    }
}
