@page "/"
@implements IDisposable
@inject IDashboardService Dashboard
@inject IConfiguracionService Configuracion
@inject AccionesCita Acciones
@inject DialogService Dialogos
@inject ISesionUsuario Sesion
@inject NavigationManager Navigation

<div class="dashboard">
    <div class="db-header">
        <div>
            <h1>@nombreEscuela</h1>
            <p class="subtitle">@Saludo, @(Sesion.Actual?.NombreCompleto.Split(' ')[0]). Este es el estado de la escuela hoy.</p>
        </div>
        <RelojDashboard />
    </div>

    @if (resumen == null)
    {
        <div class="text-center p-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        @if (resumen.CitaInminente is { } inminente)
        {
            <div class="alert-banner" role="button" @onclick="() => VerCitaAsync(inminente)">
                <span class="ico pulse-icon">notifications_active</span>
                <div>
                    <strong>Próxima cita en @MinutosPara(inminente):</strong>
                    @inminente.ClienteNombre con @inminente.InstructorNombre · Plantel @inminente.Plantel a las @Formato.Hora(inminente.HoraInicio)
                </div>
                <span class="ico ms-auto">chevron_right</span>
            </div>
        }
        @if (resumen.CitasVencidasSinCerrar.Count > 0)
        {
            <div class="alert-banner peligro" role="button" @onclick="() => AbrirListaAsync(EstadosCita.Pendiente, soloVencidas: true)">
                <span class="ico">pending_actions</span>
                <div>
                    <strong>@resumen.CitasVencidasSinCerrar.Count cita(s) ya pasaron y siguen pendientes.</strong>
                    Márquelas como completadas, no asistió o canceladas para mantener las métricas al día.
                </div>
                <span class="ico ms-auto">chevron_right</span>
            </div>
        }

        @* --- Tarjetas principales interactivas --- *@
        <div class="metrics-grid">
            <button class="metric-card yellow interactiva" @onclick="() => AbrirListaAsync(EstadosCita.Pendiente)">
                <div class="metric-icono"><span class="ico">pending_actions</span></div>
                <div>
                    <h3>Citas Pendientes</h3>
                    <span class="number">@resumen.Pendientes</span>
                    <span class="metric-accion">Ver, modificar o cancelar <span class="ico">arrow_forward</span></span>
                </div>
            </button>
            <button class="metric-card green interactiva" @onclick="() => AbrirListaAsync(EstadosCita.Completada)">
                <div class="metric-icono"><span class="ico">task_alt</span></div>
                <div>
                    <h3>Citas Completadas</h3>
                    <span class="number">@resumen.Completadas</span>
                    <span class="metric-accion">Historial rápido <span class="ico">arrow_forward</span></span>
                </div>
            </button>
            <button class="metric-card blue interactiva" @onclick="AbrirInstructoresAsync">
                <div class="metric-icono"><span class="ico">badge</span></div>
                <div>
                    <h3>Instructores Activos</h3>
                    <span class="number">@resumen.InstructoresActivos</span>
                    <span class="metric-accion">Perfiles y edición <span class="ico">arrow_forward</span></span>
                </div>
            </button>
        </div>

        @* --- Indicadores del negocio --- *@
        <div class="kpi-grid">
            <div class="kpi">
                <small><span class="ico">today</span> Citas de hoy</small>
                <strong>@resumen.CitasHoyCompletadas / @resumen.CitasHoy</strong>
                <span class="kpi-pie">completadas</span>
            </div>
            <div class="kpi">
                <small><span class="ico">payments</span> Ingresos del mes</small>
                <strong>@Formato.Colones(resumen.IngresosMes)</strong>
                @if (resumen.VariacionIngresos is { } variacion)
                {
                    <span class="kpi-pie @(variacion >= 0 ? "sube" : "baja")">
                        <span class="ico">@(variacion >= 0 ? "trending_up" : "trending_down")</span> @variacion.ToString("+0.#;-0.#")% vs. mes anterior
                    </span>
                }
                else
                {
                    <span class="kpi-pie">citas completadas</span>
                }
            </div>
            <div class="kpi">
                <small><span class="ico">event_busy</span> Cancelación del mes</small>
                <strong class="@(resumen.TasaCancelacionMes > 20 ? "text-danger" : "")">@resumen.TasaCancelacionMes.ToString("0.#")%</strong>
                <span class="kpi-pie">incluye "no asistió"</span>
            </div>
            <div class="kpi">
                <small><span class="ico">groups</span> Estudiantes activos</small>
                <strong>@resumen.EstudiantesActivos</strong>
                <span class="kpi-pie">registrados</span>
            </div>
        </div>

        <div class="db-fila">
            <div class="panel chart-section">
                <h3>Citas por mes (@DateTime.Today.Year)</h3>
                @if (resumen.SerieMensual.Any(p => p.Completadas + p.Pendientes + p.Canceladas > 0))
                {
                    <RadzenChart Style="height: 280px;">
                        <RadzenStackedColumnSeries Data="@resumen.SerieMensual" CategoryProperty="Mes" ValueProperty="Completadas" Title="Completadas" Fill="#10b981" />
                        <RadzenStackedColumnSeries Data="@resumen.SerieMensual" CategoryProperty="Mes" ValueProperty="Pendientes" Title="Pendientes" Fill="#f59e0b" />
                        <RadzenStackedColumnSeries Data="@resumen.SerieMensual" CategoryProperty="Mes" ValueProperty="Canceladas" Title="Canceladas / no asistió" Fill="#ef4444" />
                        <RadzenCategoryAxis Padding="12" />
                        <RadzenValueAxis Min="0">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>
                }
                else
                {
                    <p class="text-center text-muted p-4">Aún no hay citas registradas este año.</p>
                }
            </div>

            <div class="panel top-instructores">
                <h3>Instructores del mes</h3>
                @if (resumen.TopInstructores.Count == 0)
                {
                    <p class="text-muted">Sin citas completadas este mes.</p>
                }
                @foreach (var (top, indice) in resumen.TopInstructores.Select((t, i) => (t, i)))
                {
                    <div class="top-fila">
                        <span class="medalla m@(indice + 1)">@(indice + 1)</span>
                        <div class="flex-grow-1">
                            <strong>@top.Nombre</strong>
                            <small class="d-block text-muted">@top.Horas.ToString("0.#") h impartidas</small>
                        </div>
                        <strong>@top.Completadas</strong>
                    </div>
                }
            </div>
        </div>

        <div class="panel proximas-section">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="m-0">Próximas citas (3 días)</h3>
                @if (PuedeGestionar)
                {
                    <a class="btn btn-sm btn-primary" href="citas"><span class="ico">add</span> Nueva cita</a>
                }
            </div>
            <div class="table-responsive">
                <table class="db-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Instructor</th>
                            <th class="d-none d-md-table-cell">Plantel</th>
                            <th>Fecha y hora</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in resumen.ProximasCitas)
                        {
                            <tr @key="c.Id" class="fila-clic" @onclick="() => VerCitaAsync(c)">
                                <td><strong>@c.ClienteNombre</strong><br /><small>@c.ClienteTelefono</small></td>
                                <td>@c.InstructorNombre</td>
                                <td class="d-none d-md-table-cell">@c.Plantel</td>
                                <td><strong>@Formato.DiaRelativo(c.Fecha)</strong><br /><small>@Formato.Rango(c.HoraInicio, c.HoraFin)</small></td>
                                <td class="text-end text-nowrap" @onclick:stopPropagation>
                                    <button class="btn-icono exito" title="WhatsApp" @onclick="() => Acciones.WhatsAppRecordatorioAsync(c)"><span class="ico">chat</span></button>
                                    @if (PuedeGestionar)
                                    {
                                        <button class="btn-icono exito" title="Marcar completada" @onclick="() => CambiarEstadoAsync(c, EstadosCita.Completada)"><span class="ico">task_alt</span></button>
                                        <button class="btn-icono" title="Modificar" @onclick='() => Navigation.NavigateTo($"/citas/{c.Id}")'><span class="ico">edit</span></button>
                                        <button class="btn-icono peligro" title="Cancelar" @onclick="() => CambiarEstadoAsync(c, EstadosCita.Cancelada)"><span class="ico">event_busy</span></button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (resumen.ProximasCitas.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted">No hay citas agendadas para los siguientes 3 días.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private ResumenDashboard? resumen;
    private string nombreEscuela = "Escuela España";
    private System.Threading.Timer? refresco;

    private bool PuedeGestionar => Sesion.TieneRol(Roles.Administrador, Roles.Recepcionista);

    private static string Saludo =>
        DateTime.Now.Hour is >= 5 and <= 11 ? "Buenos días" : DateTime.Now.Hour is >= 12 and <= 18 ? "Buenas tardes" : "Buenas noches";

    protected override async Task OnInitializedAsync()
    {
        nombreEscuela = (await Configuracion.ObtenerAsync()).NombreEscuela;
        await CargarAsync();

        // Las métricas se refrescan cada minuto (el reloj tiene su propio ciclo de un segundo).
        refresco = new System.Threading.Timer(_ => InvokeAsync(async () =>
        {
            await CargarAsync();
            StateHasChanged();
        }), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private async Task CargarAsync() => resumen = await Dashboard.ObtenerResumenAsync();

    private static string MinutosPara(Cita c)
    {
        var minutos = (int)Math.Ceiling((c.InicioCompleto - DateTime.Now).TotalMinutes);
        return minutos >= 60 ? $"{minutos / 60} h {minutos % 60} min" : $"{minutos} min";
    }

    private async Task AbrirListaAsync(string estado, bool soloVencidas = false)
    {
        var titulo = estado == EstadosCita.Pendiente ? "Citas pendientes" : "Historial de citas completadas";
        await Dialogos.OpenAsync<ListaCitasDialog>(titulo,
            new Dictionary<string, object?>
            {
                [nameof(ListaCitasDialog.Estado)] = estado,
                [nameof(ListaCitasDialog.SoloVencidas)] = soloVencidas
            },
            new DialogOptions { Width = "760px", Height = "80vh", CloseDialogOnOverlayClick = true });
        await CargarAsync();
    }

    private async Task AbrirInstructoresAsync()
    {
        await Dialogos.OpenAsync<InstructoresActivosDialog>("Instructores activos", new Dictionary<string, object?>(),
            new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = true });
        await CargarAsync();
    }

    private async Task VerCitaAsync(Cita c)
    {
        if (await Acciones.VerDetalleAsync(c.Id)) await CargarAsync();
    }

    private async Task CambiarEstadoAsync(Cita c, string estado)
    {
        if (await Acciones.CambiarEstadoAsync(c, estado)) await CargarAsync();
    }

    public void Dispose() => refresco?.Dispose();
}
