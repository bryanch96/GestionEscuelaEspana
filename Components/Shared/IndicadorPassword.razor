@* Indicador en vivo de los requisitos de la contraseña. *@
@attribute [AllowAnonymous]

@if (!string.IsNullOrEmpty(Password))
{
    var errores = PoliticaPassword.Validar(Password);
    var nivel = 4 - Math.Min(4, errores.Count);
    <div class="fuerza-password nivel-@nivel">
        <div class="barra"><span style="width:@(nivel * 25)%"></span></div>
        @if (errores.Count > 0)
        {
            <small>@errores[0]</small>
        }
        else
        {
            <small>Contraseña segura ✓</small>
        }
    </div>
}

@code {
    [Parameter] public string? Password { get; set; }
}
