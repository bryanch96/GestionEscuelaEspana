@* El administrador puede fijar una contraseña temporal o enviar un código de recuperación al correo del usuario. *@
@inject IUsuarioService Usuarios
@inject IRecuperacionPasswordService Recuperacion
@inject DialogService Dialogos
@inject AccionesCita Acciones

<div>
    <div class="segmentado mb-3">
        <button class="@(porCorreo ? "activo" : "")" @onclick="() => porCorreo = true"><span class="ico">mail</span> Enviar código</button>
        <button class="@(porCorreo ? "" : "activo")" @onclick="() => porCorreo = false"><span class="ico">password</span> Contraseña temporal</button>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger py-2">@error</div>
    }

    @if (porCorreo)
    {
        <p>Se enviará un código de un solo uso a <strong>@Usuario.Correo</strong> para que el usuario defina una nueva contraseña desde "¿Olvidó su contraseña?".</p>
        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-light" @onclick="() => Dialogos.Close(false)">Cancelar</button>
            <button class="btn btn-primary" disabled="@procesando" @onclick="EnviarCodigoAsync"><span class="ico">send</span> Enviar código</button>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label">Nueva contraseña para @Usuario.NombreCompleto</label>
            <input class="form-control" type="password" @bind="nueva" @bind:event="oninput" autocomplete="new-password" />
            <IndicadorPassword Password="@nueva" />
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-light" @onclick="() => Dialogos.Close(false)">Cancelar</button>
            <button class="btn btn-primary" disabled="@procesando" @onclick="EstablecerAsync"><span class="ico">save</span> Establecer</button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Usuario Usuario { get; set; } = default!;

    private bool porCorreo = true;
    private string nueva = string.Empty;
    private string? error;
    private bool procesando;

    private async Task EnviarCodigoAsync()
    {
        procesando = true;
        try
        {
            var r = await Recuperacion.EnviarCodigoAsync(Usuario, MotivoRecuperacion.SolicitudUsuario);
            if (!r.Exito) { error = r.Mensaje; return; }
            Acciones.Notificar(true, "Código enviado", r.Mensaje);
            Dialogos.Close(true);
        }
        finally { procesando = false; }
    }

    private async Task EstablecerAsync()
    {
        procesando = true;
        try
        {
            var r = await Usuarios.EstablecerPasswordAsync(Usuario.Id, nueva);
            if (!r.Exito) { error = r.Mensaje; return; }
            Acciones.Notificar(true, "Contraseña actualizada", "Comunique la contraseña temporal al usuario de forma segura.");
            Dialogos.Close(true);
        }
        finally { procesando = false; }
    }
}
