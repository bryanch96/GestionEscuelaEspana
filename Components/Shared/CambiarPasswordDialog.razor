@inject IUsuarioService Usuarios
@inject ISesionUsuario Sesion
@inject DialogService Dialogos
@inject NotificationService Notificaciones

<EditForm Model="this" OnSubmit="GuardarAsync">
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger py-2">@error</div>
    }
    <div class="mb-3">
        <label class="form-label">Contraseña actual</label>
        <input class="form-control" type="password" @bind="actual" autocomplete="current-password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Nueva contraseña</label>
        <input class="form-control" type="password" @bind="nueva" @bind:event="oninput" autocomplete="new-password" />
        <IndicadorPassword Password="@nueva" />
    </div>
    <div class="mb-3">
        <label class="form-label">Confirmar nueva contraseña</label>
        <input class="form-control" type="password" @bind="confirmacion" autocomplete="new-password" />
    </div>
    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-light" @onclick="() => Dialogos.Close(false)">Cancelar</button>
        <button type="submit" class="btn btn-primary">Actualizar</button>
    </div>
</EditForm>

@code {
    private string actual = string.Empty;
    private string nueva = string.Empty;
    private string confirmacion = string.Empty;
    private string? error;

    private async Task GuardarAsync()
    {
        if (nueva != confirmacion)
        {
            error = "Las contraseñas no coinciden.";
            return;
        }
        var resultado = await Usuarios.CambiarPasswordAsync(Sesion.Actual!.Id, actual, nueva);
        if (!resultado.Exito)
        {
            error = resultado.Mensaje;
            return;
        }
        Notificaciones.Notify(NotificationSeverity.Success, "Contraseña actualizada", resultado.Mensaje);
        Dialogos.Close(true);
    }
}
